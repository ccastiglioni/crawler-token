APP_NAME="Crypto Listing Watchdog"
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:18080
APP_PORT=18080
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Alvo isolado desta base; compose.yaml fixa estes valores nos processos PHP.
DB_CONNECTION=mysql
DB_HOST=mysql_test
DB_PORT=3306
DB_DATABASE=crawler_token_test
DB_USERNAME=watchdog
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=crawler_token_database_
REDIS_QUEUE_RETRY_AFTER=120
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=crawler_token_cache_
SESSION_DRIVER=array

LOG_CHANNEL=stderr
LOG_LEVEL=info
MAIL_MAILER=log
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

LOCAL_UID=1000
LOCAL_GID=1000
WATCHDOG_RVN_ENABLED=true
WATCHDOG_HEALTH_MAX_AGE_SECONDS=180
